    "Track streaks, mood distribution, and reflection prompts in the same pastel notebook style." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تابع السلاسل وتوزيع المزاج وأسئلة التأمل بالأسلوب نفسه لدفتر ملاحظات بألوان هادئة."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz seguimiento de rachas, distribución del ánimo y sugerencias de reflexión con el mismo estilo de cuaderno pastel."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "Sigue rachas, distribución de ánimo y preguntas de reflexión con el mismo estilo de cuaderno pastel."
          }
        },
        "es-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue rachas, distribución de ánimo y preguntas de reflexión con el mismo estilo de cuaderno pastel."
          }
        }
      }
