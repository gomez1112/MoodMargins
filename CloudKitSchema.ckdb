DEFINE SCHEMA

    RECORD TYPE CD_Activity (
        CD_entityName     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moodEntry      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_symbol         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_symbol_ckAsset ASSET,
        CD_title          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset  ASSET,
        "___createTime"   TIMESTAMP,
        "___createdBy"    REFERENCE,
        "___etag"         STRING,
        "___modTime"      TIMESTAMP,
        "___modifiedBy"   REFERENCE,
        "___recordID"     REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_MoodEntry (
        CD_date         TIMESTAMP QUERYABLE SORTABLE,
        CD_energyLevel  INT64 QUERYABLE SORTABLE,
        CD_entityName   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_mood         BYTES QUERYABLE SORTABLE,
        CD_mood_ckAsset ASSET,
        CD_note         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_note_ckAsset ASSET,
        CD_sleepQuality INT64 QUERYABLE SORTABLE,
        CD_tags         BYTES QUERYABLE SORTABLE,
        CD_tags_ckAsset ASSET,
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
